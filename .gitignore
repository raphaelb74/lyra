# Paths are anchored to the repository root (leading `/`) unless a pattern
# must match at any depth. Avoid bare names like `debug`: they would also
# ignore future source folders with that name.

# Rust
/target/
**/*.rs.bk
**/mutants.out*/
rustc-ice-*.txt

# Frontend (apps/desktop)
node_modules/
/apps/desktop/dist/
/apps/desktop/.vite/
*.tsbuildinfo
npm-debug.log*

# Tauri: regenerated on every build
/apps/desktop/src-tauri/gen/
/apps/desktop/src-tauri/permissions/autogenerated/

# Icons `npm run icons` generates for platforms Lyra does not target
# (Linux uses the PNGs listed in tauri.conf.json).
/apps/desktop/src-tauri/icons/android/
/apps/desktop/src-tauri/icons/ios/
/apps/desktop/src-tauri/icons/Square*Logo.png
/apps/desktop/src-tauri/icons/StoreLogo.png
/apps/desktop/src-tauri/icons/icon.icns
/apps/desktop/src-tauri/icons/icon.ico

# One-off agent prompts (not project documentation)
/docs/M0_CLAUDE_VERIFICATION.md

# Local validation output (screenshots, smoke-test logs, coverage)
/artifacts/
/coverage/

# Python script caches
__pycache__/
*.py[cod]

# Local app data and secrets
*.db
*.db-shm
*.db-wal
.env
.env.*
!.env.example

# Per-user tool settings
.claude/settings.local.json
.idea/
*.iml
*.code-workspace

# Editor and OS leftovers
*~
.*.swp
.*.swo
.DS_Store
