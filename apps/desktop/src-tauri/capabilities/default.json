{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local Lyra window: playback commands and their events; no filesystem, shell, or remote capabilities",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-info",
    "allow-list-devices",
    "allow-play",
    "allow-pause",
    "allow-resume",
    "allow-stop",
    "allow-seek",
    "allow-get-status",
    "allow-get-position"
  ]
}
