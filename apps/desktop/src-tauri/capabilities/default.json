{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local Lyra window: playback, library and settings commands and their events; no filesystem, dialog, shell, or remote capabilities (the folder picker opens from Rust)",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-info",
    "allow-list-devices",
    "allow-play",
    "allow-pause",
    "allow-resume",
    "allow-stop",
    "allow-seek",
    "allow-get-status",
    "allow-get-position",
    "allow-play-tracks",
    "allow-next",
    "allow-previous",
    "allow-skip-to",
    "allow-get-queue",
    "allow-track-details",
    "allow-list-folders",
    "allow-pick-folder",
    "allow-remove-folder",
    "allow-rescan",
    "allow-get-scan-status",
    "allow-list-albums",
    "allow-album-tracks",
    "allow-list-artists",
    "allow-artist-albums",
    "allow-list-tracks",
    "allow-list-playlists",
    "allow-create-playlist",
    "allow-rename-playlist",
    "allow-delete-playlist",
    "allow-playlist-entries",
    "allow-add-to-playlist",
    "allow-remove-from-playlist",
    "allow-move-in-playlist",
    "allow-get-settings",
    "allow-set-settings"
  ]
}
