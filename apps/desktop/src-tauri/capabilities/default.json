{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local Lyra window: its own title bar (drag, minimize, maximize, close), playback, library, metadata editing, settings, device-volume and diagnostics commands and their events; no filesystem, dialog, shell, or remote capabilities (ID Match goes online from Rust, only while the setting allows) (the folder picker opens from Rust)",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "allow-get-app-info",
    "allow-list-devices",
    "allow-pause",
    "allow-resume",
    "allow-stop",
    "allow-seek",
    "allow-get-status",
    "allow-get-position",
    "allow-play-tracks",
    "allow-next",
    "allow-previous",
    "allow-skip-to",
    "allow-set-shuffle",
    "allow-enqueue-tracks",
    "allow-queue-move",
    "allow-queue-remove",
    "allow-clear-queue",
    "allow-set-repeat",
    "allow-get-queue",
    "allow-track-details",
    "allow-list-folders",
    "allow-pick-folder",
    "allow-remove-folder",
    "allow-rescan",
    "allow-get-scan-status",
    "allow-list-albums",
    "allow-album-tracks",
    "allow-list-artists",
    "allow-artist-albums",
    "allow-list-tracks",
    "allow-list-playlists",
    "allow-create-playlist",
    "allow-rename-playlist",
    "allow-delete-playlist",
    "allow-playlist-entries",
    "allow-add-to-playlist",
    "allow-remove-from-playlist",
    "allow-move-in-playlist",
    "allow-get-settings",
    "allow-set-settings",
    "allow-get-volume",
    "allow-set-volume",
    "allow-set-volume-db",
    "allow-get-diagnostics",
    "allow-probe-device",
    "allow-album-editor",
    "allow-save-album-edits",
    "allow-undo-edit",
    "allow-choose-artwork",
    "allow-reset-artwork",
    "allow-propose-fixes",
    "allow-apply-fixes",
    "allow-match-candidates",
    "allow-match-release",
    "allow-match-cover",
    "allow-apply-match"
  ]
}
