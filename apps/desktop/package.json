{
  "name": "lyra-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "tauri": "tauri",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "icons": "tauri icon assets/lyra.svg",
    "test:desktop": "python3 ../../tests/e2e/desktop-smoke.py",
    "test:dev": "python3 ../../tests/e2e/dev-smoke.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oxlint/plugins": "1.89.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
